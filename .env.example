APP_NAME=WalletService
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wallet
DB_USERNAME=root1
DB_PASSWORD=0123

SESSION_DRIVER=file
# Use a shared cache store for rate limits when the service has more than one
# application instance. Redis is preferable at larger scale; database works
# for this small compose stack.
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Leave empty to deny cross-origin browser requests. Set exact frontend origins
# as a comma-separated list when a browser client is introduced.
CORS_ALLOWED_ORIGINS=

SANCTUM_EXPIRATION=60
WALLET_MAX_AMOUNT_MINOR=1000000000000
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_IP_PER_MINUTE=30
RATE_LIMIT_REGISTRATION_PER_MINUTE=3
RATE_LIMIT_REGISTRATION_PER_HOUR=20
RATE_LIMIT_MONEY_PER_MINUTE=10
RATE_LIMIT_MONEY_IP_PER_MINUTE=60
RATE_LIMIT_AUTH_POST_PER_MINUTE=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
